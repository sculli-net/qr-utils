{
  "name": "@qr-util/render",
  "version": "0.1.0",
  "description": "Render @qr-util/core QR codes as SVG, PNG or HTML with shapes, per-pattern styling and logo excavation",
  "author": "Matt Scullino <contact@sculli.net>",
  "license": "MIT",
  "keywords": [
    "qr",
    "qrcode",
    "svg",
    "png",
    "html",
    "render",
    "rounded",
    "logo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@qr-util/core": "workspace:^",
    "fflate": "^0.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

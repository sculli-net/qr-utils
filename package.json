{
  "name": "qr-util-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace for the @qr-util packages (core QR generation + rendering)",
  "author": "Matt Scullino <contact@sculli.net>",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./lib/*\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:dev": "pnpm --filter @qr-util/website dev",
    "site:build": "pnpm --filter @qr-util/website build",
    "site:preview": "pnpm --filter @qr-util/website preview",
    "site:check": "pnpm --filter @qr-util/website check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5",
    "zxing-wasm": "^3.1.6"
  }
}

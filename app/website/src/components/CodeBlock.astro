---
import { codeToHtml } from "shiki/bundle/web";
import Clipboard from "../assets/icons/clipboard.svg";

const packageManager = {
  npm: `install`,
  pnpm: `add`,
  yarn: `add`,
  bun: `add`,
};

const PACKAGE_NAME = `@sculli/qr-utils`;

const scripts = await Promise.all(
  Object.entries(packageManager).map(async ([k, v]) => ({
    manager: k,
    html: await codeToHtml(`${k} ${v} ${PACKAGE_NAME}`, {
      lang: "zsh",
      theme: "vitesse-dark",
    }),
  })),
);

const defaultTab = scripts[0];
---

<div class="" data-code-tabs>
  <div class="">
    <ul class="flex gap-1" role="group" aria-label="Package manager">
      {
        scripts.map((s, i) => (
          <li>
            <button
              type="button"
              data-code-tab={s.manager}
              aria-pressed={i === 0}
              class="px-2 py-1 rounded-sm bg-amber-100 aria-pressed:bg-amber-400"
            >
              {s.manager}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="relative rounded-sm overflow-hidden">
    {
      scripts.map((s, i) => (
        <div
          data-code-panel={s.manager}
          hidden={i !== 0}
          set:html={s.html}
          class="[&_pre]:p-2"
        />
      ))
    }
    <div
      class="absolute right-1 top-1 z-2 text-white rounded-sm bg-slate-700 hover:bg-slate-500"
    >
      <button class="p-2 [&_svg]:size-4">
        <Clipboard />
      </button>
    </div>
  </div>
</div>

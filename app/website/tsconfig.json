{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@qr-util/core": ["../../lib/core/src/index.ts"],
      "@qr-util/core/*": ["../../lib/core/src/*"],
      "@qr-util/render": ["../../lib/render/src/index.ts"]
    }
  }
}
